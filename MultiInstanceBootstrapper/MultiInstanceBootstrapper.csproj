<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>MultiInstance Bootstrapper</ApplicationTitle>
    <AssemblyName>MultiInstanceBootstrapper</AssemblyName>
    <Version>1.2.2</Version>
    <Authors>MultiInstanceBootstrapper</Authors>
    <Description>A multi-instance Roblox bootstrapper with auto-updates.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Octokit" Version="8.0.0" />
  </ItemGroup>
</Project>
